    "./theme-overrides.css": "./src/theme-overrides.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@faclon-labs/design-sdk": "^0.7.29",
    "@faclon-labs/fds": "^0.3.0",
    "lucide-react": "^1.24.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
