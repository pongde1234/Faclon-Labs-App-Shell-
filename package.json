{
  "name": "@faclon-labs/iosense-shell",
  "version": "0.1.0",
  "description": "The iosense application chrome — the collapsible rail, top bar and menus as shipped in the product. Built on @faclon-labs/design-sdk and @faclon-labs/fds.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pongde1234/Faclon-Labs-App-Shell-.git"
  },
  "files": [
    "dist",
    "src",
    "guards"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme-overrides.css": "./src/theme-overrides.css",
    "./package.json": "./package.json",
    "./guards/index.json": "./guards/index.json",
    "./guards/*": "./guards/*",
    "./styles.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@faclon-labs/design-sdk": "^0.7.29",
    "@faclon-labs/fds": "^0.3.0",
    "lucide-react": "^1.24.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "devDependencies": {
    "@faclon-labs/design-sdk": "^0.7.29",
    "@faclon-labs/fds": "^0.3.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
