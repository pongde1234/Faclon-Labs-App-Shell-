{
  "name": "faclon-labs-app-shell",
  "private": true,
  "version": "0.0.0",
  "description": "Two application shells and a demo. @faclon-labs/app-shell is react-only and portable; @faclon-labs/iosense-shell is the product chrome built on the SDK.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "npm run build:app-shell && npm run build:iosense-shell",
    "build:app-shell": "vite build --config packages/app-shell/vite.config.ts && tsc -p packages/app-shell/tsconfig.build.json",
    "build:iosense-shell": "vite build --config packages/iosense-shell/vite.config.ts && tsc -p packages/iosense-shell/tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@faclon-labs/design-sdk": "^0.7.29",
    "@faclon-labs/fds": "^0.3.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.6.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
